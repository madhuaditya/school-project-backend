<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Advanced Report</title>
  <style>
    :root {
      --ink: #10243e;
      --muted: #5f6f88;
      --accent: #2563eb;
      --accent-soft: #dbeafe;
      --border: #d8e1ef;
      --bg: #f4f7fb;
    }

    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      padding: 24px;
      background: var(--bg);
      color: var(--ink);
      font-family: Arial, Helvetica, sans-serif;
    }

    .sheet {
      max-width: 1100px;
      margin: 0 auto;
      background: #ffffff;
      border: 1px solid var(--border);
      border-radius: 18px;
      overflow: hidden;
      box-shadow: 0 18px 50px rgba(16, 36, 62, 0.08);
    }

    .header {
      padding: 28px 32px 22px;
      background: linear-gradient(135deg, #0f172a 0%, #1d4ed8 55%, #38bdf8 100%);
      color: #fff;
    }

    .school-name {
      margin: 0;
      font-size: 30px;
      font-weight: 800;
      letter-spacing: 0.2px;
    }

    .school-address,
    .year {
      margin: 6px 0 0;
      font-size: 13px;
      opacity: 0.92;
    }

    .content {
      padding: 28px 32px 34px;
    }

    .section-title {
      margin: 0 0 14px;
      font-size: 18px;
      font-weight: 700;
      color: var(--ink);
    }

    .student-card {
      display: grid;
      grid-template-columns: 1.6fr 1fr;
      gap: 16px;
      margin-bottom: 22px;
    }

    .panel {
      border: 1px solid var(--border);
      border-radius: 16px;
      padding: 18px;
      background: #fff;
    }

    .student-lines {
      display: grid;
      gap: 8px;
      font-size: 14px;
      line-height: 1.45;
    }

    .student-lines strong,
    .meta strong,
    .summary-card strong {
      color: var(--ink);
    }

    .meta {
      display: grid;
      gap: 8px;
      font-size: 14px;
    }

    .summary-grid {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 12px;
      margin: 20px 0 24px;
    }

    .summary-card {
      padding: 16px;
      border-radius: 16px;
      background: linear-gradient(180deg, #f8fbff 0%, #eef4ff 100%);
      border: 1px solid #d8e5fb;
    }

    .summary-card .label {
      display: block;
      font-size: 12px;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--muted);
      margin-bottom: 6px;
    }

    .summary-card .value {
      font-size: 20px;
      font-weight: 800;
      color: var(--ink);
    }

    table {
      width: 100%;
      border-collapse: collapse;
      margin-top: 8px;
      overflow: hidden;
      border-radius: 14px;
    }

    th,
    td {
      border: 1px solid var(--border);
      padding: 12px 10px;
      font-size: 14px;
      text-align: left;
    }

    th {
      background: #eff6ff;
      color: var(--ink);
      font-weight: 700;
    }

    tbody tr:nth-child(even) td {
      background: #fbfdff;
    }

    .footer {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 20px;
      margin-top: 26px;
    }

    .remark,
    .signature {
      border: 1px solid var(--border);
      border-radius: 14px;
      padding: 16px;
      min-height: 88px;
      background: #fff;
    }

    .signature {
      display: flex;
      align-items: end;
      justify-content: center;
      font-size: 14px;
      color: var(--muted);
    }

    @media print {
      body {
        background: #fff;
        padding: 0;
      }

      .sheet {
        border-radius: 0;
        box-shadow: none;
        border: none;
      }

      .content {
        padding: 22px 28px 30px;
      }
    }

    @media (max-width: 900px) {
      .student-card,
      .summary-grid,
      .footer {
        grid-template-columns: 1fr;
      }
    }
  </style>
</head>
<body>
  <div class="sheet">
    <header class="header">
      <h1 class="school-name"><%= school.name %></h1>
      <% if (school.address) { %>
        <p class="school-address"><%= school.address %></p>
      <% } %>
      <p class="year">Academic Year: <%= academicYear %></p>
    </header>

    <main class="content">
      <h2 class="section-title">Student Result Summary</h2>
      <section class="student-card">
        <div class="panel">
          <div class="student-lines">
            <div><strong>Name:</strong> <%= student.name %></div>
            <div><strong>Father Name:</strong> <%= student.fatherName %></div>
            <div><strong>Mother Name:</strong> <%= student.motherName %></div>
            <div><strong>Roll Number:</strong> <%= student.rollNumber %></div>
          </div>
        </div>
        <div class="panel">
          <div class="meta">
            <div><strong>Class:</strong> <%= classData.name %></div>
            <div><strong>Section:</strong> <%= classData.section %></div>
            <div><strong>Grade:</strong> <%= summary.grade %></div>
          </div>
        </div>
      </section>

      <section>
        <h2 class="section-title">Subject Performance</h2>
        <table>
          <thead>
            <tr>
              <th>Subject</th>
              <th>Obtained</th>
              <th>Total</th>
              <th>Percentage</th>
              <th>Grade</th>
            </tr>
          </thead>
          <tbody>
            <% subjects.forEach((subject) => { %>
              <tr>
                <td><%= subject.subjectName %></td>
                <td><%= subject.obtained %></td>
                <td><%= subject.total %></td>
                <td><%= subject.percentage %>%</td>
                <td><%= subject.grade %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </section>

      <section class="summary-grid">
        <div class="summary-card">
          <span class="label">Total Marks</span>
          <div class="value"><%= summary.obtainedMarks %>/<%= summary.totalMarks %></div>
        </div>
        <div class="summary-card">
          <span class="label">Percentage</span>
          <div class="value"><%= summary.percentage %>%</div>
        </div>
        <div class="summary-card">
          <span class="label">Grade</span>
          <div class="value"><%= summary.grade %></div>
        </div>
        <div class="summary-card">
          <span class="label">Academic Year</span>
          <div class="value"><%= academicYear %></div>
        </div>
      </section>

      <section class="footer">
        <div class="remark">
          <strong>Remarks</strong>
          <p style="margin: 10px 0 0; color: #45556c; font-size: 14px; line-height: 1.5;"><%= remarks %></p>
        </div>
        <div class="signature">Class Teacher Signature</div>
      </section>
    </main>
  </div>
</body>
</html>
